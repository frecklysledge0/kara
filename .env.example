# =====================================================================
# MillProof Environment Variables
# =====================================================================

# Gemini API Key (Called exclusively from server-side route handlers)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Postgres & Storage Configuration
# Project URL: https://app.supabase.com/
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (NEVER expose to client side)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Storage Bucket Name for Private MTR Documents
SUPABASE_MTR_BUCKET="mtr-documents"

# Environment Mode
NODE_ENV="development"
